{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark-custom",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "quietStartup": true,
  "doubleEscapeAction": "none",
  "packages": [
    "npm:pi-vimmode",
    "npm:pi-subagents",
    "npm:@xynogen/pix-gate",
    "npm:@narumitw/pi-starship",
    "npm:pi-session-summary",
    "npm:pi-copy-message",
    "npm:pi-effort",
    "npm:pi-autoresearch",
    "npm:@dietrichgebert/ponytail"
  ],
  "piVimMode": {
    "preset": "prompt-safe",
    "startMode": "insert",
    "keymap": {
      "motions": {
        "firstNonBlank": [
          "^",
          "_",
          "H"
        ],
        "lineEnd": [
          "$",
          "L"
        ]
      },
      "commands": {
        "visualBlock": [
          "<A-b>"
        ],
        "showKeybindings": [
          "k"
        ]
      }
    }
  },
  "subagents": {
    "defaultModel": "opencode-go/glm-5.3-flash",
    "defaultThinking": "max",
    "agentOverrides": {
      "scout": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "off"
      },
      "researcher": {
        "model": "opencode-go/glm-5.3"
      },
      "reviewer": {
        "model": "opencode-go/qwen3.8-max",
        "thinking": "medium"
      },
      "oracle": {
        "model": "opencode-go/qwen3.8-max",
        "thinking": "max"
      },
      "worker": {
        "model": "opencode-go/glm-5.3-flash",
        "thinking": "max"
      }
    }
  }
}